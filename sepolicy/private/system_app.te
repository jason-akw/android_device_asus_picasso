# PicassoParts controls the single-color rear Snapdragon logo LED.
allow system_app sysfs_leds:dir search;
allow system_app sysfs_aura_logo_led:file rw_file_perms;

# Settings reads zram status from the memory/battery screens.
allow system_app sysfs_zram:dir r_dir_perms;
allow system_app sysfs_zram:file r_file_perms;
allow system_app proc_pagetypeinfo:file r_file_perms;

# Settings probes these services while collecting battery and network details.
binder_call(system_app, hal_wifi_supplicant_server)
binder_call(system_app, system_suspend)

# AOSP intentionally keeps these services hidden from ordinary system_app.
dontaudit system_app {
    system_suspend_control_service
    system_suspend_control_internal_service
    tracingproxy_service
}:service_manager find;

# Settings probes these vendor HALs during device info collection.
dontaudit system_app {
    hal_audio
    hal_power
    hal_vibrator
}:binder call;
